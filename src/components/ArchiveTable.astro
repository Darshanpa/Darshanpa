---
import SpecSheet from './SpecSheet.astro';
import { drawerId, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  context: string;
}

const { projects, context } = Astro.props;
---

<table class="index" data-filter-table>
  <thead>
    <tr>
      <th scope="col" class="col-year">Year</th>
      <th scope="col">Project / System</th>
      <th scope="col" class="col-domain">Domain</th>
      <th scope="col" class="col-tools">Tools</th>
      <th scope="col" class="col-cue"><span class="sr-only">Spec sheet</span></th>
    </tr>
  </thead>
  <tbody>
    {
      projects.map((project) => {
        const id = drawerId(context, project);
        const { data } = project;
        return (
          <>
            <tr
              class="row"
              data-item
              data-row-trigger
              data-slug={project.id}
              data-categories={data.categories.join(' ')}
            >
              <td class="col-year">{data.year}</td>
              <td class="col-title">
                <button
                  type="button"
                  class="row__trigger"
                  data-spec-trigger
                  data-slug={project.id}
                  aria-expanded="false"
                  aria-controls={id}
                >
                  {data.title}
                </button>
                {data.org && <span class="row__org">{data.org}</span>}
                <span class="row__domain">{data.domain}</span>
              </td>
              <td class="col-domain">{data.domain}</td>
              <td class="col-tools">{data.tools.slice(0, 4).join(' · ')}</td>
              <td class="col-cue" aria-hidden="true">
                <span class="cue" />
              </td>
            </tr>
            <tr class="drawer-row" id={id} data-spec-drawer hidden>
              <td colspan="5">
                <SpecSheet project={project} />
              </td>
            </tr>
          </>
        );
      })
    }
  </tbody>
</table>

<style>
  .index {
    width: 100%;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    text-align: left;
  }

  th {
    padding: 0 0.75rem 0.625rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
  }

  .row td {
    padding: 0.875rem 0.75rem;
    border-bottom: 1px solid var(--line);
    line-height: 1.35rem;
    vertical-align: top;
    transition: background-color 0.15s;
  }

  th:first-child,
  .row td:first-child {
    padding-left: 0.625rem;
  }

  .row {
    cursor: pointer;
  }

  .row:hover td,
  .row.is-active td {
    background: var(--surface);
  }

  .row.is-active td {
    border-bottom-color: transparent;
  }

  .col-year {
    width: 4.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--cobalt);
  }

  th.col-year {
    color: var(--muted);
  }

  .row__trigger {
    padding: 0;
    border: 0;
    background: none;
    font-weight: 550;
    line-height: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 0.15s;
  }

  .row:hover .row__trigger,
  .row.is-active .row__trigger {
    color: var(--signal);
  }

  .row__org {
    display: block;
    margin-top: 0.125rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .row__domain {
    display: block;
    margin-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  td.col-domain {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  td.col-tools {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .col-domain,
  .col-tools {
    display: none;
  }

  .col-cue {
    width: 2.25rem;
    text-align: right;
  }

  /* plus that becomes a minus when the row is open */
  .cue {
    position: relative;
    display: inline-block;
    width: 0.6875rem;
    height: 0.6875rem;
    color: var(--muted);
    transition: color 0.15s;
  }

  .cue::before,
  .cue::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }

  .cue::after {
    transform: rotate(90deg);
  }

  .row:hover .cue,
  .row.is-active .cue {
    color: var(--signal);
  }

  .row.is-active .cue::after {
    transform: rotate(0deg);
  }

  .drawer-row > td {
    padding: 0;
  }

  .drawer-row :global(.spec) {
    margin-top: 0.25rem;
  }

  @media (min-width: 40rem) {
    .col-domain {
      display: table-cell;
    }

    .row__domain {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .col-tools {
      display: table-cell;
    }
  }
</style>
