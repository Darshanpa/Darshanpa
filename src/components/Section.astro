---
import { sections, type SectionId } from '../data/site';
import { entryCount } from '../lib/projects';

interface Props {
  id: SectionId;
  /** Number of project entries in this section; shown top right and updated by the filter. */
  count: number;
  lede?: string;
}

const { id, count, lede } = Astro.props;
const section = sections.find((s) => s.id === id)!;
---

<section class="section" id={id} aria-labelledby={`${id}-title`} data-filter-group data-section>
  <header class="section__head">
    <h2 id={`${id}-title`}>
      <span class="section__num">{section.number}.</span>
      {section.heading}
    </h2>
    <span class="mono-label section__count" data-group-count>{entryCount(count)}</span>
  </header>

  {lede && <p class="section__lede">{lede}</p>}

  <slot />

  <p class="section__empty" data-empty hidden>
    <span class="mono-label">No entries match this filter.</span>
    <button type="button" class="bracket-btn" data-filter-reset>Show all</button>
  </p>

  <slot name="after" />
</section>

<style>
  .section {
    padding-top: 3.5rem;
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .section__num {
    margin-right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--cobalt);
  }

  .section__count {
    flex: none;
    white-space: nowrap;
  }

  .section__lede {
    max-width: 40rem;
    margin: -0.25rem 0 1.5rem;
    color: var(--muted);
  }

  .section__empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }
</style>
