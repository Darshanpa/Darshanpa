---
import { categories } from '../data/site';
import { pad } from '../lib/projects';

interface Props {
  total: number;
}

const { total } = Astro.props;
const filters = [{ id: 'all', label: 'All' }, ...categories];
---

<div class="bar" data-filter-bar>
  <div class="bar__pills" role="group" aria-label="Filter projects by category">
    {
      filters.map((filter) => (
        <button
          type="button"
          class="pill"
          data-filter={filter.id}
          aria-pressed={filter.id === 'all' ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))
    }
  </div>
  <p class="mono-label bar__count" aria-live="polite">
    <span data-filter-count>{pad(total)}</span> / {pad(total)} projects
  </p>
</div>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--bar-h);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--line);
    background: rgb(9 13 22 / 0.86);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .bar__pills {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .bar__pills::-webkit-scrollbar {
    display: none;
  }

  .pill {
    flex: none;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }

  .pill::before {
    content: '[';
    margin-right: 0.1em;
    color: var(--cobalt);
  }

  .pill::after {
    content: ']';
    margin-left: 0.1em;
    color: var(--cobalt);
  }

  .pill:hover {
    border-color: var(--cobalt);
    color: var(--cobalt);
  }

  .pill[aria-pressed='true'] {
    border-color: var(--signal);
    background: var(--signal-wash);
    color: var(--signal);
  }

  .pill[aria-pressed='true']::before,
  .pill[aria-pressed='true']::after {
    color: var(--signal);
  }

  .bar__count {
    display: none;
    flex: none;
  }

  .bar__count [data-filter-count] {
    color: var(--text);
  }

  @media (min-width: 76rem) {
    .bar__pills {
      margin-inline: 0;
      padding-inline: 0;
    }

    .bar__count {
      display: block;
    }
  }
</style>
