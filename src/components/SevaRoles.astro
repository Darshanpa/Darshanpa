---
import { seva } from '../data/site';
---

<ul class="roles">
  {
    seva.roles.map((role) => (
      <li class="role">
        <p class="mono-label">
          <span class="accent">{role.code}</span> / {role.period}
        </p>
        <h3 class="role__name">{role.name}</h3>
        <p class="mono-label role__org">{role.org}</p>
        <p class="role__spec">{role.spec}</p>
      </li>
    ))
  }
</ul>

<style>
  .roles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
    gap: 1px;
    padding: 1px;
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.125rem 1.125rem;
    /* 1px rings overlap in the 1px gap, so an unfilled last row leaves no empty cell */
    box-shadow: 0 0 0 1px var(--line);
  }

  .role__name {
    margin-top: 0.25rem;
    font-size: var(--text-md);
    font-weight: 600;
  }

  .role__org {
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .role__spec {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
