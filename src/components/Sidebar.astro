---
import Icon from './Icon.astro';
import { principles, sections, site, socials } from '../data/site';
---

<header class="rail">
  <div class="rail__inner">
    <div class="rail__identity">
      <p class="mono-label rail__kicker">
        <span class="accent">{site.idPrefix}</span> / Engineering Portfolio
      </p>
      <h1 class="rail__name">{site.name}</h1>
      <p class="rail__title">{site.title}</p>
      <p class="rail__bio">{site.bio.join(' ')}</p>
      <ul class="rail__creds mono-label">
        {site.credentials.map((line) => <li>{line}</li>)}
      </ul>
    </div>

    <nav class="rail__nav" aria-label="Sections">
      <ul>
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.id}`} data-nav={section.id}>
                <span class="nav__num">{section.number}.</span>
                <span class="nav__rule" aria-hidden="true" />
                <span class="nav__label">{section.nav}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="principles" aria-labelledby="principles-title">
      <header class="principles__head">
        <h2 class="mono-label" id="principles-title">Operating Principles</h2>
        <span class="mono-label principles__rev">Rev C</span>
      </header>
      <dl class="principles__list">
        {
          principles.map((p) => (
            <div class="principle">
              <dt>
                <span class="principle__code">{p.code}</span>
                <span class="principle__name">{p.name}</span>
              </dt>
              <dd>{p.spec}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="rail__contact">
      <ul class="socials">
        {
          socials.map((link) => (
            <li>
              <a
                href={link.href}
                aria-label={link.label}
                title={link.label}
                {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}
              >
                <Icon name={link.id} />
              </a>
            </li>
          ))
        }
      </ul>
      {
        site.status && (
          <p class="status">
            <span class="status__dot" aria-hidden="true" />
            {site.status}
          </p>
        )
      }
    </div>
  </div>
</header>

<style>
  .rail {
    border-bottom: 1px solid var(--line);
  }

  .rail__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2.5rem var(--gutter) 2rem;
  }

  .rail__identity {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rail__kicker {
    margin-bottom: 0.5rem;
  }

  .rail__name {
    font-size: var(--text-xl);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .rail__title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--cobalt);
  }

  .rail__bio {
    max-width: 34rem;
    margin-top: 0.375rem;
    color: var(--muted);
  }

  .rail__creds {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .rail__creds li {
    position: relative;
    padding-left: 1rem;
  }

  .rail__creds li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.5rem;
    height: 1px;
    background: var(--cobalt);
  }

  /* ── Section nav ── */
  .rail__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .rail__nav a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s;
  }

  .nav__num {
    color: var(--cobalt);
    font-variant-numeric: tabular-nums;
  }

  .nav__rule {
    display: none;
    width: 1.5rem;
    height: 1px;
    background: var(--line);
    transition:
      width 0.25s var(--ease),
      background-color 0.15s;
  }

  .rail__nav a:hover,
  .rail__nav a[aria-current='true'] {
    color: var(--text);
  }

  .rail__nav a:hover .nav__rule,
  .rail__nav a[aria-current='true'] .nav__rule {
    width: 3rem;
    background: var(--cobalt);
  }

  /* ── Operating principles: a small spec block ── */
  .principles {
    max-width: 34rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .principles__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--line);
  }

  .principles__head h2 {
    letter-spacing: 0.08em;
    line-height: inherit;
  }

  .principles__rev {
    color: var(--cobalt);
  }

  .principle {
    padding: 0.625rem 0.875rem;
  }

  .principle + .principle {
    border-top: 1px solid var(--line);
  }

  .principle dt {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .principle__code {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--cobalt);
  }

  .principle__name {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .principle dd {
    padding-left: calc(5ch + 0.625rem);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--muted);
  }

  /* ── Contact ── */
  .rail__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .socials a:hover {
    color: var(--text);
    border-color: var(--signal);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.625rem 0.3125rem 0.5rem;
    border: 1px solid var(--signal-line);
    border-radius: 999px;
    background: var(--signal-wash);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--signal);
  }

  .status__dot {
    position: relative;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--signal);
  }

  .status__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--signal);
    animation: ping 2.4s var(--ease) infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* ── Desktop: fixed rail ── */
  @media (min-width: 64rem) {
    .rail {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      scrollbar-width: none;
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }

    .rail::-webkit-scrollbar {
      display: none;
    }

    .rail__inner {
      min-height: 100%;
      gap: clamp(1rem, 2.8vh, 2.25rem);
      padding: clamp(1.25rem, 4.5vh, 3.5rem) clamp(1.5rem, 2.6vw, 2.75rem);
    }

    .rail__nav ul {
      flex-direction: column;
      gap: 0;
    }

    .nav__rule {
      display: block;
    }

    .rail__contact {
      margin-top: auto;
    }
  }

  /* Short laptop screens: keep the rail on one screen by dropping the principle descriptions. */
  @media (min-width: 64rem) and (max-height: 58rem) {
    .principle dd {
      display: none;
    }
  }

  @media (min-width: 64rem) and (max-height: 46rem) {
    .rail__creds {
      display: none;
    }
  }
</style>
